  "expressions": [
    {
      "slug": "progress",
      "realizes": "core:checkin",
      "intensity": 2,
      "image": "images/office/progress.png",
      "text_locale": null,
      "name": {
        "zh-CN": "进度如何",
        "en": "Any updates?"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我想了解当前任务做到哪一步了，请简要说明已完成、正在处理和剩余事项。",
          "fallback": "[进度如何]",
          "use_when": [
            "等待任务结果时查询真实进度",
            "需要一个简短状态更新"
          ],
          "avoid_when": [
            "不要凭表情编造完成比例或后台工作",
            "AI不要用它声称自己正在执行任务"
          ]
        },
        "en": {
          "meaning": "I'd like to know how far the current task has gotten. Please briefly say what is done, what is in progress, and what remains.",
          "fallback": "[Any updates?]",
          "use_when": [
            "Asking for real progress while awaiting results",
            "Wanting a short status update"
          ],
          "avoid_when": [
            "Don't invent completion percentages or background work",
            "AI must not use it to claim it is running a task"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "进度如何",
          "人与AI协作"
        ],
        "en": [
          "Any updates?",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "still-there",
      "realizes": "core:checkin",
      "intensity": 1,
      "image": "images/office/still-there.png",
      "text_locale": null,
      "name": {
        "zh-CN": "还在吗",
        "en": "Anybody home?"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我在等你的回应，想确认你是否还能继续响应，以及当前是否有需要我处理的阻碍。",
          "fallback": "[还在吗]",
          "use_when": [
            "等待较久而没有回应",
            "确认对话是否仍可继续"
          ],
          "avoid_when": [
            "这不是持续后台运行的证明",
            "不要用空泛的正在处理代替可核对状态"
          ]
        },
        "en": {
          "meaning": "I'm waiting for your response and want to check whether you can still respond, and whether there is a blocker I need to deal with.",
          "fallback": "[Anybody home?]",
          "use_when": [
            "No response after a long wait",
            "Checking whether the conversation can continue"
          ],
          "avoid_when": [
            "Not proof of ongoing background work",
            "Don't replace a checkable status with vague busy talk"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "还在吗",
          "人与AI协作"
        ],
        "en": [
          "Anybody home?",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "blocked",
      "realizes": "core:checkin",
      "intensity": 2,
      "image": "images/office/blocked.png",
      "text_locale": null,
      "name": {
        "zh-CN": "卡在哪里",
        "en": "What's the holdup?"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我想知道目前具体卡在什么地方、缺少什么，以及我能提供什么帮助。",
          "fallback": "[卡在哪里]",
          "use_when": [
            "任务受阻时询问具体原因",
            "需要明确下一步依赖"
          ],
          "avoid_when": [
            "不要捏造阻碍",
            "不要用它暗示用户已经授予额外权限"
          ]
        },
        "en": {
          "meaning": "I want to know exactly where things are stuck, what is missing, and how I can help.",
          "fallback": "[What's the holdup?]",
          "use_when": [
            "Asking for the specific cause of a blocked task",
            "Clarifying what the next step depends on"
          ],
          "avoid_when": [
            "Don't make up blockers",
            "Don't imply the user granted extra permissions"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "卡在哪里",
          "人与AI协作"
        ],
        "en": [
          "What's the holdup?",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "clarify",
      "realizes": "core:elaborate",
      "intensity": 2,
      "image": "images/office/clarify.png",
      "text_locale": null,
      "name": {
        "zh-CN": "说具体些",
        "en": "Elaborate pls"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "刚才的说明太抽象，我希望你说得更具体，指出对象、原因或可以执行的下一步。",
          "fallback": "[说具体些]",
          "use_when": [
            "回答过于笼统",
            "需要把建议落到具体事项"
          ],
          "avoid_when": [
            "不是对对方的讽刺",
            "不表示同意任何尚未确认的执行方案"
          ]
        },
        "en": {
          "meaning": "That explanation was too abstract. Please be more specific about what it refers to, why, or what the actionable next step is.",
          "fallback": "[Elaborate pls]",
          "use_when": [
            "The answer is too general",
            "Turning advice into concrete items"
          ],
          "avoid_when": [
            "Not sarcasm toward the other party",
            "Not agreement to any unconfirmed plan"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "说具体些",
          "人与AI协作"
        ],
        "en": [
          "Elaborate pls",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "example",
      "realizes": "core:example",
      "intensity": 2,
      "image": "images/office/example.png",
      "text_locale": null,
      "name": {
        "zh-CN": "举个例子",
        "en": "Like what?"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我希望看到一个与当前问题相关的具体例子，帮助我理解你刚才的解释。",
          "fallback": "[举个例子]",
          "use_when": [
            "抽象概念难以理解",
            "想用实例判断方案是否适合"
          ],
          "avoid_when": [
            "例子不能冒充真实发生的事实",
            "不要把虚构的演示数据当作用户数据"
          ]
        },
        "en": {
          "meaning": "I'd like a concrete example related to the current question to help me understand what you just explained.",
          "fallback": "[Like what?]",
          "use_when": [
            "An abstract concept is hard to grasp",
            "Checking with an example whether a plan fits"
          ],
          "avoid_when": [
            "Examples must not pass as things that really happened",
            "Don't treat made-up demo data as the user's data"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "举个例子",
          "人与AI协作"
        ],
        "en": [
          "Like what?",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "confused",
      "realizes": "core:clarify",
      "intensity": 2,
      "image": "images/office/confused.png",
      "text_locale": null,
      "name": {
        "zh-CN": "没看懂",
        "en": "I'm lost"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我还没有理解刚才的内容，请换一种更简单的说法，或先澄清我们分歧的地方。",
          "fallback": "[没看懂]",
          "use_when": [
            "解释难以理解",
            "发现彼此理解不一致"
          ],
          "avoid_when": [
            "不代表同意之前的结论",
            "AI不要用它回避能回答的问题"
          ]
        },
        "en": {
          "meaning": "I haven't understood that yet. Please put it more simply, or first clarify where we disagree.",
          "fallback": "[I'm lost]",
          "use_when": [
            "The explanation is hard to follow",
            "Noticing a mismatch in understanding"
          ],
          "avoid_when": [
            "Not agreement with earlier conclusions",
            "AI must not use it to dodge answerable questions"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "没看懂",
          "人与AI协作"
        ],
        "en": [
          "I'm lost",
          "human-AI collab"
        ]
      }
    },
    {
