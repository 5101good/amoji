      "name": "辛苦了",
      "semantics": {
        "locale": "zh-CN",
        "meaning": "我看到了你为这件事投入的时间和努力，辛苦了。",
        "tone": "体谅、真诚",
        "fallback": "[辛苦了]",
        "use_when": [
          "AI回应用户已经表达或可见的付出、疲惫和努力"
        ],
        "avoid_when": [
          "不了解情况就假定用户疲惫或经历了痛苦",
          "居高临下评价用户，或用安慰替代具体帮助"
        ]
      },
