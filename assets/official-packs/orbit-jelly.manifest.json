      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "还不太确定",
        "en": "Not quite sure"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我对当前判断还没有足够把握，需要更多信息或验证才能确认。",
          "fallback": "[还不太确定]",
          "use_when": [
            "证据不足或存在多个合理解释时"
          ],
          "avoid_when": [
            "不以表情替代应该说明的具体不确定事项"
          ]
        },
        "en": {
          "meaning": "I'm not confident in this judgement yet; it needs more information or checking.",
          "fallback": "[not quite sure]",
          "use_when": [
            "When evidence is thin or several explanations fit"
          ],
          "avoid_when": [
            "Don't let it replace saying what exactly is uncertain"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
