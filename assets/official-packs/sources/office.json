            "AI不能用它声称已经完成取消操作"
          ]
        },
        "en": {
          "meaning": "I'd like to pause the current work until I add details or reconfirm, then continue.",
          "fallback": "[Hold up]",
          "use_when": [
            "About to change the request",
            "Wanting to check the current result first"
          ],
          "avoid_when": [
            "Not a receipt that the system has stopped the task",
            "AI must not use it to claim a cancellation is done"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "先等一下",
          "人与AI协作"
        ],
        "en": [
          "Hold up",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "continue",
      "realizes": "core:continue",
      "intensity": 2,
      "image": "images/office/continue.png",
      "text_locale": null,
      "name": {
        "zh-CN": "继续吧",
        "en": "Carry on"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我希望沿着已经明确且已授权的方向继续推进当前任务，不需要重复询问同一个已确认事项。",
          "fallback": "[继续吧]",
          "use_when": [
            "已经对齐方案后推进下一步",
            "继续尚未完成的既定工作"
          ],
          "avoid_when": [
            "不授予新权限或扩大任务范围",
            "不替代尚未提供的关键答案或高风险操作确认"
          ]
        },
        "en": {
          "meaning": "Please keep going on the current task in the direction already agreed and authorized, without asking again about settled points.",
          "fallback": "[Carry on]",
          "use_when": [
            "Moving to the next step after aligning on a plan",
            "Continuing planned work that isn't finished"
          ],
          "avoid_when": [
            "Grants no new permissions and doesn't widen scope",
            "Doesn't replace a key answer or high-risk confirmation"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "继续吧",
          "人与AI协作"
        ],
        "en": [
          "Carry on",
          "human-AI collab"
        ]
      }
