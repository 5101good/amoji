          ]
        },
        "en": {
          "meaning": "That's a lot of information; let's start with the key points and expand step by step.",
          "fallback": "[that's a lot]",
          "use_when": [
            "When a reply is too long or too detailed"
          ],
          "avoid_when": [
            "Don't drop important risks or facts because of it"
          ],
          "translation": {
