    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "d7f7b1ac-0036-4f90-8ea5-f7a916c5a201",
      "realizes": "core:encourage",
      "intensity": 3,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "给你打气",
        "en": "Rooting for you"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我想给你一些鼓励，认可你的努力，祝你接下来顺利。",
          "fallback": "[给你打气]",
          "use_when": [
            "对方正在努力时",
            "开始有挑战的工作之前"
          ],
          "avoid_when": [
            "不保证成功，也不替代必要的具体帮助"
          ]
        },
        "en": {
          "meaning": "I want to cheer you on, recognize your effort and wish you luck with what comes next.",
          "fallback": "[rooting for you]",
          "use_when": [
            "While someone is working hard",
            "Before starting challenging work"
          ],
          "avoid_when": [
            "It doesn't promise success or replace concrete help"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "给你打气",
          "鼓励",
          "感谢",
          "回应"
        ],
        "en": [
          "Rooting for you",
          "encouragement",
          "thanks",
          "acknowledgement"
        ]
      },
