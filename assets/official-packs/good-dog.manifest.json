{
  "kind": "amoji.pack",
  "amoji": "0.1",
  "pack_id": "2a01ad10-a763-4839-866f-5f78b0897ee0",
  "version": 1,
  "original_locale": "zh-CN",
  "locales": [
    "zh-CN",
    "en"
  ],
  "name": {
    "zh-CN": "搭把手犬",
    "en": "Good Dog"
  },
  "description": {
    "zh-CN": "热情但不抢戏的毛绒搭档。接住你的消息，也认真回应每一份善意。",
    "en": "A soft, enthusiastic teammate. Every message received, every kindness returned."
  },
  "expressions": [
    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "4de35ffb-4ea0-45a2-b54e-fc17b9466925",
      "realizes": "core:celebrate",
      "intensity": 2,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "击个掌",
        "en": "High five"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "为我们刚刚共同完成的一步击个掌，分享这份开心。",
          "fallback": "[击个掌]",
          "use_when": [
            "共同完成一个步骤时",
            "回应对方分享的好消息时"
          ],
          "avoid_when": [
            "不把庆祝当作未验证任务的完成证明"
          ]
        },
        "en": {
          "meaning": "A high five for the step we just finished together; sharing the good moment.",
          "fallback": "[high five]",
          "use_when": [
            "After finishing a step together",
            "When answering good news"
          ],
          "avoid_when": [
            "Don't treat celebration as proof that unverified work is done"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "击个掌",
          "鼓励",
          "感谢",
          "回应"
        ],
        "en": [
          "High five",
          "encouragement",
          "thanks",
          "acknowledgement"
        ]
      },
