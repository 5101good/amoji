    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "9d23f82f-bb95-412e-a99e-515b9cc474af",
      "realizes": "core:ack",
      "intensity": 2,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "收到啦",
        "en": "Got it!"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "你的这条消息我收到了，也理解了其中明确表达的意思。",
          "fallback": "[收到啦]",
          "use_when": [
            "确认收到清楚的消息时",
            "无需长篇回复的日常交接时"
          ],
          "avoid_when": [
            "有歧义时应先澄清；收到不代表任务已经完成或权限已经授予"
          ]
        },
        "en": {
          "meaning": "I received your message and understood what it clearly says.",
          "fallback": "[got it]",
          "use_when": [
            "Confirming a clear message",
            "Everyday handoffs that need no long reply"
          ],
          "avoid_when": [
            "Clarify ambiguity first; receipt isn't completion or permission"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "收到啦",
          "鼓励",
          "感谢",
          "回应"
        ],
        "en": [
          "Got it!",
          "encouragement",
          "thanks",
          "acknowledgement"
        ]
      },
