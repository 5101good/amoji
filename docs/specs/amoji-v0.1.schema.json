{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amoji:schema:0.1",
  "title": "Amoji v0.1 data contracts",
  "description": "结构约束；素材完整性、不可变性、默认引用及投递行为还须满足配套协议。",
  "oneOf": [
    {
      "$ref": "#/$defs/revision"
    },
    {
      "$ref": "#/$defs/pack"
    },
    {
      "$ref": "#/$defs/message"
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "meaning",
        "fallback"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "maxLength": 48
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "use_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "maxItems": 4,
          "minItems": 0,
          "uniqueItems": true
        },
        "avoid_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "maxItems": 4,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "mime",
        "bytes",
        "width",
        "height"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "animated"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/blob"
        },
        "animated": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "poster": {
          "allOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "properties": {
                "mime": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "animated": {
                "const": true
              }
            },
            "required": [
              "animated"
            ]
          },
          "then": {
            "required": [
              "duration_ms",
              "poster"
            ],
            "properties": {
              "primary": {
                "properties": {
                  "mime": {
                    "enum": [
                      "image/gif",
                      "image/webp"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "primary": {
                "properties": {
                  "mime": {
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_ms"
                  ]
                },
                {
                  "required": [
                    "poster"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "asset_id",
        "revision_id",
        "name",
        "created_at",
        "semantics",
        "visual",
        "rights"
      ],
      "properties": {
        "kind": {
          "const": "amoji.expression"
        },
        "schema_version": {
          "const": "0.1"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "\\S"
          },
          "maxItems": 12,
          "minItems": 0,
          "uniqueItems": true
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "derived_from": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "pack_id",
        "name",
        "created_at",
        "expressions",
        "defaults"
      ],
      "properties": {
        "kind": {
          "const": "amoji.pack"
        },
        "schema_version": {
          "const": "0.1"
        },
        "pack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "defaults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "maxItems": 200,
          "minItems": 1
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "message_id",
        "binding_id",
        "direction",
        "created_at",
        "revision"
      ],
      "properties": {
        "kind": {
          "const": "amoji.message"
        },
        "schema_version": {
          "const": "0.1"
        },
        "message_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "binding_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "direction": {
          "enum": [
            "human_to_ai",
            "ai_to_human"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    }
  }
}

