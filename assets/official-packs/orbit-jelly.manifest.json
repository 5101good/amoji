  "locales": [
    "zh-CN",
    "en"
  ],
  "name": {
    "zh-CN": "灵感水母",
    "en": "Orbit Jelly"
  },
  "description": {
    "zh-CN": "一团会发光的好奇心。让还没成形的想法，在对话里慢慢浮现。",
    "en": "A little luminous curiosity. A place for unfinished thoughts to take shape together."
  },
  "expressions": [
    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "f5460a85-9dce-4b06-a1c3-c220e2cc57ed",
      "realizes": "core:idea",
      "intensity": 1,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "换个可能呢",
        "en": "What if…"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我们可以试着从另一种可能性看这件事，先讨论，不急着作决定。",
          "fallback": "[换个可能呢]",
          "use_when": [
            "脑暴或遇到思路局限时"
          ],
          "avoid_when": [
            "不据此擅自推翻已确认的需求或修改方案"
          ]
        },
        "en": {
          "meaning": "Let's look at this from another possibility first and discuss it before deciding.",
          "fallback": "[what if]",
          "use_when": [
            "Brainstorming or when thinking feels stuck"
          ],
          "avoid_when": [
            "Don't overturn confirmed requirements or the plan with it"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "换个可能呢",
          "探索",
          "灵感",
          "不确定"
        ],
        "en": [
          "What if…",
          "exploration",
          "ideas",
          "uncertainty"
        ]
      },
