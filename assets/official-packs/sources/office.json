          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "方向不对",
          "人与AI协作"
        ],
        "en": [
          "That's not it",
          "human-AI collab"
        ]
      }
    },
    {
      "slug": "wait",
      "realizes": "core:hold",
      "intensity": 2,
      "image": "images/office/wait.png",
      "text_locale": null,
      "name": {
        "zh-CN": "先等一下",
        "en": "Hold up"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我希望先暂停当前推进，等我补充说明或重新确认后再继续。",
          "fallback": "[先等一下]",
          "use_when": [
            "准备修改要求",
