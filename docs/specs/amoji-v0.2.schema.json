{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amoji:schema:0.2",
  "title": "Amoji scenario pack 0.2",
  "$ref": "#/$defs/pack",
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "meaning",
        "fallback"
      ],
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "maxLength": 48
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "tone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "use_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "maxItems": 4,
          "minItems": 0,
          "uniqueItems": true
        },
        "avoid_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          },
          "maxItems": 4,
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "mime",
        "bytes",
        "width",
        "height"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "animated"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/blob"
        },
        "animated": {
          "type": "boolean"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "poster": {
          "allOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "properties": {
                "mime": {
                  "enum": [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "animated": {
                "const": true
              }
            },
            "required": [
              "animated"
            ]
          },
          "then": {
            "required": [
              "duration_ms",
              "poster"
            ],
            "properties": {
              "primary": {
                "properties": {
                  "mime": {
                    "enum": [
                      "image/gif",
                      "image/webp"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "primary": {
                "properties": {
                  "mime": {
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_ms"
                  ]
                },
                {
                  "required": [
                    "poster"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "asset_id",
        "revision_id",
        "name",
        "created_at",
        "semantics",
        "visual",
        "rights"
      ],
      "properties": {
        "kind": {
          "const": "amoji.expression"
        },
        "schema_version": {
          "const": "0.1"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "pattern": "\\S"
          },
          "maxItems": 12,
          "minItems": 0,
          "uniqueItems": true
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "derived_from": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "actionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_revision_id"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action_revision_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "releaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "release_id"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "action_revision_id",
            "locale",
            "effect_summary",
            "conflict_group",
            "rights",
            "kind",
            "scope",
            "instruction"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "action_revision_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
              "maxLength": 48
            },
            "effect_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "conflict_group": {
              "enum": [
                "explanation",
                "response-organization",
                "completion-report",
                "handoff"
              ]
            },
            "rights": {
              "$ref": "#/$defs/rights"
            },
            "kind": {
              "const": "instruction"
            },
            "scope": {
              "const": "turn"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "action_revision_id",
            "locale",
            "effect_summary",
            "conflict_group",
            "rights",
            "kind",
            "scope",
            "template",
            "config"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "action_revision_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
              "maxLength": 48
            },
            "effect_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "conflict_group": {
              "const": "response-organization"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            },
            "kind": {
              "const": "hook"
            },
            "scope": {
              "const": "conversation"
            },
            "template": {
              "const": "response-organization@1"
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layout"
              ],
              "properties": {
                "layout": {
                  "enum": [
                    "answer-first",
                    "concise",
                    "example-first"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_id",
            "action_revision_id",
            "locale",
            "effect_summary",
            "conflict_group",
            "rights",
            "kind",
            "scope",
            "template",
            "config"
          ],
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "action_revision_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
              "maxLength": 48
            },
            "effect_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "conflict_group": {
              "const": "completion-report"
            },
            "rights": {
              "$ref": "#/$defs/rights"
            },
            "kind": {
              "const": "hook"
            },
            "scope": {
              "const": "conversation"
            },
            "template": {
              "const": "completion-self-check@1"
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence",
                "unknowns"
              ],
              "properties": {
                "evidence": {
                  "const": "required"
                },
                "unknowns": {
                  "const": "explicit"
                }
              }
            }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "actions"
      ],
      "properties": {
        "expression": {
          "$ref": "#/$defs/ref"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionRef"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "pack_id",
        "release_id",
        "version",
        "name",
        "created_at",
        "scenario",
        "expressions",
        "defaults",
        "actions",
        "bindings",
        "rights"
      ],
      "properties": {
        "kind": {
          "const": "amoji.pack"
        },
        "schema_version": {
          "const": "0.2"
        },
        "pack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "defaults": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          },
          "maxItems": 200,
          "minItems": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scenario": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 0,
          "maxItems": 200,
          "uniqueItems": true
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "enum": [
              "response-organization@1",
              "completion-self-check@1"
            ]
          },
          "minItems": 0,
          "maxItems": 2,
          "uniqueItems": true
        },
        "derived_from": {
          "$ref": "#/$defs/releaseRef"
        }
      }
    }
  }
}