{
  "name": "@amoji/dsh",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "index.mjs",
    "client.js",
    "runtime",
    "assets",
    "web",
    "patch.yml",
    "BUILD.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY.json",
    "THIRD_PARTY_LICENSES",
    "README.en.md"
  ],
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "sharp": "0.35.4",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "license": "MIT",
  "description": "AI-native expressions for dsh: images for people, immutable text semantics for AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/5101good/amoji.git",
    "directory": "adapters/dsh"
  },
  "homepage": "https://github.com/5101good/amoji#readme",
  "bugs": {
    "url": "https://github.com/5101good/amoji/issues"
  },
  "keywords": [
    "amoji",
    "dsh",
    "deepseek",
    "ai",
    "expressions",
    "emoji",
    "plugin"
  ]
}
