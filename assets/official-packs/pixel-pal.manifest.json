  "name": {
    "zh-CN": "像素搭档",
    "en": "Pixel Pal"
  },
  "description": {
    "zh-CN": "从像素世界走来的小机器人。陪你专注、找问题，也庆祝扎实的每一步。",
    "en": "A tiny robot for focused work, curious debugging and well-earned checkpoints."
  },
  "expressions": [
    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "23aae35d-391e-4146-ae28-6768628e4af9",
      "realizes": "core:working",
      "intensity": 2,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "认真处理中",
        "en": "Heads down"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我此刻正在认真处理眼前这件事，暂时还没有要报告的最终结果。",
          "fallback": "[认真处理中]",
          "use_when": [
            "确实正在处理当前任务时"
          ],
          "avoid_when": [
            "不能暗示实际上不存在的后台工作或持续执行"
          ]
        },
        "en": {
          "meaning": "I'm working carefully on this right now and have no final result to report yet.",
          "fallback": "[heads down]",
          "use_when": [
            "When really working on the current task"
          ],
          "avoid_when": [
            "Never imply background work that isn't happening"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "认真处理中",
          "专注",
          "排障",
          "灵感"
        ],
