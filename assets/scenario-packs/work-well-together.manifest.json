      "name": "卡在哪里",
      "semantics": {
        "locale": "zh-CN",
        "meaning": "我想知道目前具体卡在什么地方、缺少什么，以及我能提供什么帮助。",
        "tone": "直接、愿意配合",
        "fallback": "[卡在哪里]",
        "use_when": [
          "任务受阻时询问具体原因",
          "需要明确下一步依赖"
        ],
        "avoid_when": [
          "不要捏造阻碍",
          "不要用它暗示用户已经授予额外权限"
        ]
      },
