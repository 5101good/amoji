{
  "kind": "amoji.pack",
  "amoji": "0.1",
  "pack_id": "dbd45bc2-b332-4798-8062-3b5349b41b60",
  "version": 1,
  "original_locale": "zh-CN",
  "locales": [
    "zh-CN",
    "en"
  ],
  "name": {
    "zh-CN": "慢半拍猫",
    "en": "Slow Cat"
  },
  "description": {
    "zh-CN": "一只不催你的水彩小猫。给思考留点空白，也给努力留一点温柔。",
    "en": "A watercolor cat with no hurry. Room to think, and a little kindness for the effort."
  },
  "expressions": [
    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "04d24780-4599-4242-a1d5-1e3266b4e580",
      "realizes": "core:rest",
      "intensity": 1,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "先喘口气",
        "en": "Breather"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "先缓一缓，给自己一点喘息的空间；不用因为这句表达而催促或继续推进任务。",
          "fallback": "[先喘口气]",
          "use_when": [
            "人想短暂放松时",
            "AI 温和回应对方的疲惫时"
          ],
          "avoid_when": [
            "不要据此擅自取消、暂停或修改正在运行的任务"
          ]
        },
        "en": {
          "meaning": "Let's slow down and take a breath; this is not a nudge to push the task forward.",
          "fallback": "[breather]",
          "use_when": [
            "When someone wants a short break",
            "When the AI gently answers signs of tiredness"
          ],
          "avoid_when": [
            "Never cancel, pause or change running work because of it"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "先喘口气",
          "放松",
          "陪伴",
          "思考"
        ],
        "en": [
          "Breather",
          "rest",
          "companionship",
          "reflection"
        ]
      },
