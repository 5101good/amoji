    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "419e016a-5773-4a52-8120-c4178f858ff5",
      "realizes": "core:thanks",
      "intensity": 3,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "多亏有你",
        "en": "Couldn't without you"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "谢谢你刚才提供的帮助或支持，这份投入对我很有帮助。",
          "fallback": "[多亏有你]",
          "use_when": [
            "人感谢 AI 的帮助时",
            "AI 感谢人补充信息或纠正问题时"
          ],
          "avoid_when": [
            "不夸大帮助，也不暗示情感依赖"
          ]
        },
        "en": {
          "meaning": "Thank you for the help or support just now; it really helped me.",
          "fallback": "[thank you]",
          "use_when": [
            "When a person thanks the AI for help",
            "When the AI thanks someone for info or a correction"
          ],
          "avoid_when": [
            "Don't exaggerate the help or imply emotional dependence"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "多亏有你",
          "鼓励",
          "感谢",
          "回应"
        ],
        "en": [
