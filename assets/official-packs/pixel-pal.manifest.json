    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "7ba4f140-9fca-4e50-8979-fb5117856e7a",
      "realizes": "core:concern",
      "intensity": 2,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "揪出小问题",
        "en": "Found a glitch"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "这里可能有一个需要排查的问题，我正在关注线索，原因尚待确认。",
          "fallback": "[揪出小问题]",
          "use_when": [
            "发现异常、开始排查时"
          ],
          "avoid_when": [
            "未经检查不要宣称已定位原因或完成修复"
          ]
        },
        "en": {
          "meaning": "There may be a problem here worth investigating; I'm following the clues and the cause is not confirmed yet.",
          "fallback": "[found a glitch]",
          "use_when": [
            "When something looks wrong and investigation starts"
          ],
          "avoid_when": [
            "Don't claim the cause is found or fixed before checking"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
