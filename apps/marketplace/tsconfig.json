{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "web/**/*.tsx",
    "worker-configuration.d.ts",
    "test/transaction-probe.ts"
  ]
}
