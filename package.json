{
  "name": "amoji",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node scripts/test.mjs",
    "test:file": "tsx --test",
    "probe:codex": "node scripts/probes/codex.mjs",
    "build:dsh": "npm run build && node scripts/build-dsh-plugin.mjs",
    "test:dsh": "npm run build:dsh && node scripts/dsh/prepare-baseline.mjs && tsx --test tests/dsh-*.test.ts",
    "prepare:dsh": "node scripts/dsh/prepare-baseline.mjs",
    "probe:dsh:context": "node scripts/probes/dsh-native-context.mjs",
    "build:claude": "npm run build && node scripts/build-claude-mods-ui.mjs && node scripts/build-claude-mods.mjs",
    "test:claude": "node scripts/build-claude-mods-ui.mjs && claude plugin validate plugins/amoji-claude-mods --strict && claude plugin test plugins/amoji-claude-mods",
    "test:claude-artifact": "npm run build:claude && node --test scripts/claude-mods-artifact.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/jsdom": "27.0.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "esbuild": "0.28.2",
    "jsdom": "28.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "description": "AI-native expressions for dsh: images for people, immutable text semantics for AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/5101good/amoji.git"
  },
  "homepage": "https://github.com/5101good/amoji#readme",
  "bugs": {
    "url": "https://github.com/5101good/amoji/issues"
  },
  "keywords": [
    "amoji",
    "dsh",
    "deepseek",
    "ai",
    "expressions",
    "emoji",
    "plugin"
  ]
}
