      "asset_id": "a21338d5-2dd6-420d-a656-6db51827dcbb",
      "realizes": "core:idea",
      "intensity": 1,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "有个小点子",
        "en": "Tiny idea"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "我想到一个可以讨论或验证的点子，先把它作为可能的方向提出。",
          "fallback": "[有个小点子]",
          "use_when": [
            "提出初步想法时",
            "邀请一起讨论一个方案时"
          ],
          "avoid_when": [
            "点子不等于已经验证的结论或实施授权"
          ]
        },
        "en": {
          "meaning": "I have an idea worth discussing or testing; I'm offering it as one possible direction.",
          "fallback": "[tiny idea]",
          "use_when": [
            "Suggesting a first idea",
            "Inviting discussion of an approach"
          ],
          "avoid_when": [
            "An idea is not a verified conclusion or permission to implement"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
