  "name": {
    "zh-CN": "纸片鹅",
    "en": "Paper Goose"
  },
  "description": {
    "zh-CN": "有一点戏，但很有分寸。用剪纸小鹅接住意外、提醒重点，把沟通变轻松。",
    "en": "A little theatrical, but never over the top. A paper-cut goose that greets surprises, highlights what matters and keeps conversations light."
  },
  "expressions": [
    {
      "kind": "amoji.expression",
      "amoji": "0.1",
      "asset_id": "c0d915e5-7124-4079-b648-b1b40c8200c7",
      "realizes": "core:hold",
      "intensity": 1,
      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "鹅等一下",
        "en": "Hold on, honk"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "先等一下，我有一点需要补充或确认，希望暂缓眼前的讨论节奏。",
          "fallback": "[鹅等一下]",
          "use_when": [
            "需要打断补充信息时"
          ],
          "avoid_when": [
            "不表示取消任务、撤回权限或终止后台进程"
          ]
        },
        "en": {
          "meaning": "Hold on a moment; I have something to add or check and would like to pause the discussion briefly.",
          "fallback": "[hold on]",
          "use_when": [
            "When interrupting to add information"
          ],
          "avoid_when": [
            "Doesn't cancel work, withdraw permission or stop processes"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine-reviewed"
          }
        }
      },
      "tags": {
        "zh-CN": [
          "鹅等一下",
          "幽默",
          "提醒",
          "简化"
        ],
        "en": [
