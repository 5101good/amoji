{
  "name": "amoji",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "test:file": "tsx --test",
    "probe:codex": "node scripts/probes/codex.mjs",
    "build:dsh": "npm run build && node scripts/build-dsh-plugin.mjs",
    "test:dsh": "npm run build:dsh && node scripts/dsh/prepare-baseline.mjs && tsx --test tests/dsh-*.test.ts",
    "pretest": "npm run build:dsh && node scripts/dsh/prepare-baseline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.27.4",
    "jsdom": "28.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
