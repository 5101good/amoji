      "original_locale": "zh-CN",
      "name": {
        "zh-CN": "好像连上了",
        "en": "Something connects"
      },
      "semantics": {
        "zh-CN": {
          "meaning": "这两个想法或线索之间似乎存在联系，值得一起看看是否成立。",
          "fallback": "[好像连上了]",
          "use_when": [
            "发现潜在关联时"
          ],
          "avoid_when": [
            "不把关联当作因果，也不把猜想当作事实"
          ]
        },
        "en": {
          "meaning": "These two ideas or clues seem related; it's worth checking together whether that holds.",
          "fallback": "[something connects]",
          "use_when": [
            "Spotting a possible connection"
          ],
          "avoid_when": [
            "Don't treat a connection as cause, or a guess as fact"
          ],
          "translation": {
            "from": "zh-CN",
            "method": "machine"
          }
        }
      },
