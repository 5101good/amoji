    {
      "slug": "progress",
      "name": "进度如何",
      "group": "进度",
      "semantics": {
        "locale": "zh-CN",
        "meaning": "我想了解当前任务做到哪一步了，请简要说明已完成、正在处理和剩余事项。",
        "tone": "友好、关注进展",
        "fallback": "[进度如何]",
        "use_when": [
          "等待任务结果时查询真实进度",
          "需要一个简短状态更新"
        ],
        "avoid_when": [
          "不要凭表情编造完成比例或后台工作",
          "AI不要用它声称自己正在执行任务"
        ]
      },
      "tags": [
        "协作:进度",
        "进度如何",
        "人与AI协作"
      ]
    },
